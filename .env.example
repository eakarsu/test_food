# Database
DATABASE_URL="postgresql://username:password@localhost:5432/modern_website_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="uploads"

# CORS
CORS_ORIGIN="http://localhost:3000"
